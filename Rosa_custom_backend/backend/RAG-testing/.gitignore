# Ignore test result files (timestamped outputs)
rag_test_results_*.json
test_queries_*.json  
test_summary_*.md

# Ignore any logs
*.log

# Ignore Python cache
__pycache__/
*.pyc
*.pyo

# Ignore temporary files
*.tmp
*.temp

# Keep configuration and scripts
!config.json
!rag_test_suite.py
!run_tests.py
!README.md
!.gitignore 